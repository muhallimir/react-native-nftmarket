{
  "expo": {
    "name": "NFT Marketplace",
    "slug": "nft-marketplace",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nftmarket",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amirsali.nftmarket"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.amirsali.nftmarket"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "author": "Amirsali",
      "authorEmail": "mir23wpurposes@gmail.com",
      "github": "https://github.com/muhallimir/react-native-nftmarket",
      "eas": {
        "projectId": "4adb4e65-6537-4126-8002-8337ed1c5131"
      }
    },
    "owner": "amirsali"
  }
}
